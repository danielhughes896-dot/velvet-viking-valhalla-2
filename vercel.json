{
  "framework": null,
  "installCommand": "",
  "buildCommand": "",
  "outputDirectory": ".",

  "functions": {
    "api/app.js": { "includeFiles": "protected/**" },
    "api/account.js": { "includeFiles": "protected/**" }
  },

  "routes": [
    { "src": "/", "dest": "/api/app" },
    { "src": "/app", "dest": "/api/app" },
    { "src": "/protected/(.*)", "dest": "/api/app" },
    { "src": "/velvet-viking-valhalla\\.html", "dest": "/api/app" },
    { "src": "/auth", "dest": "/api/app" },
    { "src": "/auth/(.*)", "dest": "/api/app" },

    { "src": "/api/subscription", "dest": "/api/account?resource=subscription" },
    { "src": "/api/checkout", "dest": "/api/account?resource=checkout" },
    { "src": "/api/preview", "dest": "/api/account?resource=preview" },
    { "src": "/api/account-data", "dest": "/api/account?resource=account-data" },
    { "src": "/api/account-delete", "dest": "/api/account?resource=account-delete" },

    { "src": "/api/strava-auth", "dest": "/api/strava?route=strava-auth" },
    { "src": "/api/strava-callback", "dest": "/api/strava?route=strava-callback" },
    { "src": "/api/strava-enabled", "dest": "/api/strava?route=strava-enabled" },
    { "src": "/api/strava-sync", "dest": "/api/strava?route=strava-sync" },
    { "src": "/api/strava-webhook", "dest": "/api/strava?route=strava-webhook" },
    { "src": "/api/strava-admin", "dest": "/api/strava?route=strava-admin" },

    { "src": "/api/garmin-status", "dest": "/api/garmin?route=garmin-status" },

    { "src": "/start", "dest": "/start.html" },
    { "src": "/account", "dest": "/account.html" },
    { "src": "/get", "dest": "/get.html" },
    { "src": "/admin", "dest": "/admin.html" },
    { "src": "/privacy", "dest": "/privacy.html" },
    { "src": "/terms", "dest": "/terms.html" },
    { "src": "/\\.well-known/assetlinks\\.json", "dest": "/assetlinks.json" },

    { "handle": "filesystem" }
  ]
}
