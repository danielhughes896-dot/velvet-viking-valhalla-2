<?xml version="1.0" encoding="utf-8"?>
<!-- The Today widget at its very smallest: one short row, 110 by 40dp.
     WHY TODAY IS NOT HERE. On the single row, TODAY keeps a 44dp column of
     its own so it is never cut; at 110dp wide that left the session 30dp,
     and no session ("14.5 KM INTERVALS", "REST DAY", "OPEN SACORO") fits 30dp
     at any font size. Found by the device check at every font size. Here the
     session has the whole width under the mark instead, centred under it,
     and shrinks to fit (dp minimum) rather than being cut. From 160dp wide
     the row with TODAY returns. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/widget_mark"
        android:layout_width="match_parent"
        android:layout_height="14dp"
        android:gravity="center_horizontal"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:text="•  SACORO  •"
        android:textColor="#E3B15A"
        android:textSize="10sp"
        android:textStyle="bold"
        android:letterSpacing="0.16"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="6dp"
        android:autoSizeMaxTextSize="10sp"
        android:autoSizeStepGranularity="0.5dp" />

    <TextView
        android:id="@+id/widget_session"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:text="SACORO"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="6dp"
        android:autoSizeMaxTextSize="40sp"
        android:autoSizeStepGranularity="0.5dp" />
</LinearLayout>
