<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      allowBackup=false, and it is not caution for its own sake. The shell is a
      WebView pointed at the live site, so what lives on the device is the
      athlete's signed-in session and their locally cached plan -- which, for a
      consenting athlete, includes heart rates, readiness answers and how each
      session felt. Android's auto-backup would copy that to the user's Google
      Drive, and `adb backup` would copy it to any machine the phone is plugged
      into. Neither is a place special-category data has any business being, and
      neither is disclosed anywhere the athlete would see it.

      usesCleartextTraffic=false is already the platform default at targetSdk 36.
      It is stated anyway, because the Play Data Safety declaration asserts that
      data is encrypted in transit and an assertion should be checkable in the
      manifest rather than inferred from an SDK level that a future bump could
      move.
    -->
    <application
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Android App Link for the site itself. autoVerify asks Android to
              fetch /.well-known/assetlinks.json from EACH host below and match
              this APK's signing certificate against it; only then will tapping
              an /auth link open the app instead of the browser. That file
              already carries the real vvv-release.keystore fingerprint; what's
              still missing is CI actually signing a build with that same key
              (the four VVV_KEYSTORE_* secrets; see ANDROID-APP-LINKS.md). Until
              a build is installed that matches the published fingerprint, this
              filter stays unverified and the custom scheme below is what
              carries the sign-in link into the app.

              THE CANONICAL DOMAIN IS FIRST, AND THAT IS THE CORRECTION. This
              filter claimed only the *.vercel.app deployment host, while the
              auth callback, VVV_SITE_ORIGIN and the Supabase Site URL were all
              moved to app.velvetviking.co.uk -- so a sign-in link sent to an
              athlete's real domain would not have opened the app at all. The
              deployment host is kept alongside it rather than replaced: the
              same deployment answers on both, both serve the same assetlinks
              file, and an athlete with an older link should not be stranded.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="app.velvetviking.co.uk"
                    android:pathPrefix="/auth" />
                <data
                    android:scheme="https"
                    android:host="app.velvetviking.co.uk"
                    android:pathPrefix="/start" />
                <data
                    android:scheme="https"
                    android:host="velvet-viking-valhalla-1.vercel.app"
                    android:pathPrefix="/auth" />
            </intent-filter>

            <!--
              Custom scheme: com.velvetviking.valhalla://auth#access_token=...
              Needs no domain verification and no stable signing key, so it works
              on a debug-signed APK today. The magic-link email points at
              supabase.co, which 302s to whatever we passed as email_redirect_to;
              pointing that at this scheme is what hands the tokens to the app.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="com.velvetviking.valhalla"
                    android:host="auth" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
