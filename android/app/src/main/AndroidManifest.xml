<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      BACKUP IS OFF, and this is a security decision rather than a preference.

      The WebView's localStorage is where vvv_cloud_session lives, and that holds
      the Supabase access and refresh tokens. With allowBackup="true" Android Auto
      Backup copies the app's data directory to the athlete's Google Drive, so a
      refresh token good for a live account ends up in third-party cloud storage
      that neither the athlete nor Valhalla is managing as a credential store.
      admin-user.js already acknowledges the exposure in prose ("any Android Auto
      Backup of it are on hardware we do not control and cannot reach"); this is
      the line that stops it happening.

      WHAT AN ATHLETE LOSES, stated honestly: restoring onto a new phone no longer
      carries the plan or the session across, so they sign in again and
      cloudReconcile() pulls the plan down from their account. That is the path the
      product is built around and the one every second device already takes. The
      alternative was a token in a Drive backup, which is not a trade worth making
      to save one sign-in.

      dataExtractionRules covers Android 12+ (device-to-device transfer and cloud
      backup are separate switches there), and fullBackupContent covers 11 and
      below. Both point at rules that exclude everything, so the two eras agree.
    -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Android App Link for the site itself. autoVerify asks Android to
              fetch https://velvet-viking-valhalla-1.vercel.app/.well-known/assetlinks.json
              and match this APK's signing certificate against it; only then will
              tapping an /auth link open the app instead of the browser. That file
              already carries the real vvv-release.keystore fingerprint; what's
              still missing is CI actually signing a build with that same key
              (the four VVV_KEYSTORE_* secrets; see ANDROID-APP-LINKS.md). Until a
              build is installed that matches the published fingerprint, this
              filter stays unverified and the custom scheme below is what carries
              the sign-in link into the app.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="velvet-viking-valhalla-1.vercel.app"
                    android:pathPrefix="/auth" />
            </intent-filter>

            <!--
              Custom scheme: com.velvetviking.valhalla://auth#access_token=...
              Needs no domain verification and no stable signing key, so it works
              on a debug-signed APK today. The magic-link email points at
              supabase.co, which 302s to whatever we passed as email_redirect_to;
              pointing that at this scheme is what hands the tokens to the app.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="com.velvetviking.valhalla"
                    android:host="auth" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
