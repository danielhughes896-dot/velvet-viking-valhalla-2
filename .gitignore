# Node tooling (Capacitor CLI) -- not needed by the Vercel static deployment
node_modules/

# Android Studio / local SDK path (machine-specific, regenerated by Gradle)
android/local.properties

# Signing keys must never be committed -- anyone holding one can sign an APK
# that installs as an update over yours. They live in GitHub Actions secrets.
*.keystore
*.jks
*.p12
