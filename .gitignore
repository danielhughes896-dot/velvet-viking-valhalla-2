# Node tooling (Capacitor CLI) -- not needed by the Vercel static deployment
node_modules/

# Android Studio / local SDK path (machine-specific, regenerated by Gradle)
android/local.properties

# Signing keys must never be committed -- anyone holding one can sign an APK
# that installs as an update over yours. They live in GitHub Actions secrets.
*.keystore
*.jks
*.p12

# Environment files never belong in the repository -- they are exactly the
# place a service-role key or a webhook secret ends up by accident.
.env
.env.*
!.env.example
tools/content-bridge/.state.json

# Screenshot output from tools/shots/*.js -- regenerated on demand, and
# several MB of PNG per run. The scripts are the artefact worth keeping.
tools/shots/toggles/
tools/shots/record/
